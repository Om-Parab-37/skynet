# Skynet configuration.
#
# Settings nest with a double underscore: SKYNET_MODEL__PROVIDER=openrouter
#
# Replace REPLACE_WITH_* values with unique local credentials before using Docker Compose.
# LANGFUSE_ENCRYPTION_KEY must be exactly 64 hexadecimal characters.
# The point of this file is that swapping any mandated technology is a change
# here, not a change in the agent runtime.

# ------------------------------------------------------------------ model
# ollama | openrouter | gemini | openai_compat
SKYNET_MODEL__PROVIDER=ollama
SKYNET_MODEL__NAME=qwen3.5:9b
# Inside Compose the host's Ollama is reachable via host.docker.internal.
SKYNET_MODEL__BASE_URL=http://host.docker.internal:11434/v1
SKYNET_MODEL__TEMPERATURE=0.0
# SKYNET_MODEL__API_KEY=...              # required for openrouter and gemini
#
# Gemini example (its endpoint is built in, so BASE_URL is not needed):
#   SKYNET_MODEL__PROVIDER=gemini
#   SKYNET_MODEL__NAME=gemini-2.5-flash
#   SKYNET_MODEL__API_KEY=AIza...
# Force prompt-based tool calling even if the provider claims native support.
SKYNET_MODEL__FORCE_TOOL_EMULATION=false

# ---------------------------------------------------------------- prompts
SKYNET_PROMPTS__DIRECTORY=prompts
SKYNET_PROMPTS__USE_LANGFUSE=false

# ---------------------------------------------------------------- tracing
# noop | console | langfuse
SKYNET_TRACING__BACKEND=console

# Needed only with the `langfuse` compose profile, or Langfuse Cloud.
SKYNET_LANGFUSE__HOST=http://langfuse-web:3000
SKYNET_LANGFUSE__PUBLIC_KEY=REPLACE_WITH_LANGFUSE_PUBLIC_KEY
SKYNET_LANGFUSE__SECRET_KEY=REPLACE_WITH_LANGFUSE_SECRET_KEY

# ---------------------------------------------------------------- storage
# memory | filesystem | minio
SKYNET_STORAGE__BACKEND=minio
SKYNET_STORAGE__ENDPOINT=minio:9000
SKYNET_STORAGE__ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
SKYNET_STORAGE__SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
SKYNET_STORAGE__BUCKET=skynet

# ----------------------------------------------------------------- memory
# inmemory | postgres
# `inmemory` is process-local: the API and the worker hold different stores and
# nothing survives a restart. `postgres` is the shared, durable one.
SKYNET_MEMORY__BACKEND=postgres
SKYNET_MEMORY__DSN=
# Recall is dispatched outside the tool timeout, so this is the only thing
# standing between a hung query and a hung run.
SKYNET_MEMORY__STATEMENT_TIMEOUT_MS=10000

# -------------------------------------------------------------- embedding
# hashing | null | ollama | gemini | openai_compat
#
# `hashing` is the default so that `docker compose up` always yields a working
# store with no model to pull. It is deterministic and offline, and buys partial
# credit for word variants -- but it is not semantic: "car" will not find
# "vehicle". Switch to `ollama` for that.
#
#   ollama pull nomic-embed-text          # 768-dim, ~274MB
#   SKYNET_EMBEDDING__BACKEND=ollama
#
# 768 dimensions throughout: it keeps a local model and Gemini (via its
# Matryoshka `dimensions` parameter) interchangeable, and stays under pgvector's
# 2000-dimension index ceiling. Changing it means re-embedding --
# `TRUNCATE memory_vectors` and a backfill -- and the store refuses to start on
# a mismatch rather than silently returning nothing.
SKYNET_EMBEDDING__BACKEND=hashing
SKYNET_EMBEDDING__MODEL=nomic-embed-text
SKYNET_EMBEDDING__BASE_URL=http://host.docker.internal:11434
SKYNET_EMBEDDING__DIMENSIONS=768
# SKYNET_EMBEDDING__API_KEY=...           # required for gemini

# ---------------------------------------------------------------- sandbox
# local | docker
SKYNET_SANDBOX__BACKEND=docker
SKYNET_SANDBOX__IMAGE=python:3.13-slim
SKYNET_SANDBOX__MEMORY_MB=512
SKYNET_SANDBOX__CPUS=1.0
SKYNET_SANDBOX__NETWORK=false

# -------------------------------------------------------------- execution
# inprocess | temporal
SKYNET_EXECUTION__ENGINE=temporal
SKYNET_TEMPORAL__HOST=temporal:7233
SKYNET_TEMPORAL__NAMESPACE=default
SKYNET_TEMPORAL__TASK_QUEUE=skynet-agents

SKYNET_LOG_LEVEL=INFO

# ------------------------------------------------- host port overrides
# Change these if a port is already in use on your machine.
SKYNET_API_PORT=8000
TEMPORAL_UI_PORT=8233
MINIO_CONSOLE_PORT=9001
# 5433, because 5432 is usually already taken on a dev machine.
SKYNET_MEMORY_PORT=5433

# ------------------------------------------------- langfuse profile only
LANGFUSE_PORT=3000
LANGFUSE_SALT=REPLACE_WITH_LANGFUSE_SALT
LANGFUSE_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY
NEXTAUTH_SECRET=REPLACE_WITH_NEXTAUTH_SECRET

CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_PASSWORD
LANGFUSE_USER_PASSWORD=REPLACE_WITH_LANGFUSE_USER_PASSWORD
SKYNET_DB_USER=REPLACE_WITH_SKYNET_DB_USER
SKYNET_DB_PASSWORD=REPLACE_WITH_SKYNET_DB_PASSWORD
TEMPORAL_DB_USER=REPLACE_WITH_TEMPORAL_DB_USER
TEMPORAL_DB_PASSWORD=REPLACE_WITH_TEMPORAL_DB_PASSWORD
LANGFUSE_DB_USER=REPLACE_WITH_LANGFUSE_DB_USER
LANGFUSE_DB_PASSWORD=REPLACE_WITH_LANGFUSE_DB_PASSWORD
CLICKHOUSE_USER=REPLACE_WITH_CLICKHOUSE_USER
LANGFUSE_USER_PASSWORD=REPLACE_WITH_LANGFUSE_USER_PASSWORD
